APP_ENV=CHANGE_ME
APP_SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
DATABASE_URL=CHANGE_ME
REDIS_URL=CHANGE_ME
SMTP_HOST=CHANGE_ME
SMTP_PORT=CHANGE_ME
FRONTEND_ORIGIN=http://localhost:3000
# Password shared by the demo users created by the seed script (Phase 2B). 12+ characters.
SEED_USER_PASSWORD=CHANGE_ME
# Object storage for uploaded files (Phase 3). The access key and secret are made up by you; see scripts/setup_env.ps1.
S3_ENDPOINT_URL=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=CHANGE_ME
# Needed from Phase 6 for live answers. Optional: without it everything else works. Add it to your local .env only, never here.
# OPENAI_API_KEY=
# Needed from Phase 8C to sync a GitHub repository. Optional. A READ-ONLY fine-grained token for one repository; local .env only, never here.
# GITHUB_TOKEN=
# Operations (Phase 9B). Optional; these are the defaults.
# AUDIT_RETENTION_DAYS=365   # audit records older than this are removed every night; 0 keeps everything; otherwise at least 30
# KEEP_VERSIONS=3            # passages of the newest N versions of a document are kept
